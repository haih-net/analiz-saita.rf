{
  "name": "haih-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "build": "react-router build && tsc -p tsconfig.server.json",
    "clean": "node -e \"fs.rmSync('build',{recursive:true,force:true});fs.rmSync('.react-router',{recursive:true,force:true})\"",
    "types": "react-router typegen && tsc --noEmit",
    "start": "node build/node/index.js",
    "test": "node --test tests/http.test.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
