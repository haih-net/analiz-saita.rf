{
  "name": "haih-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "build": "react-router build && tsc -p tsconfig.server.json",
    "clean": "node -e \"fs.rmSync('build',{recursive:true,force:true});fs.rmSync('.react-router',{recursive:true,force:true})\"",
    "router:gen": "react-router typegen",
    "types": "npm run router:gen && tsc --noEmit",
    "types:watch": "npm run router:gen && tsc --noEmit --watch",
    "start": "node build/node/index.js",
    "test": "node --test tests/http.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:seo": "node --experimental-strip-types --test tests/seo.test.mjs"
  },
  "dependencies": {
    "@linaria/core": "^8.2.0",
    "@linaria/react": "^8.2.0",
    "@react-router/fs-routes": "^8.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^8.4.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@wyw-in-js/vite": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.9",
    "storybook": "^10.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.3.1"
  }
}
